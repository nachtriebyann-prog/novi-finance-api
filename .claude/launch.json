{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Novi Finance Site (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "novi-finance-site", "-p", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "Novi Finance Site (Python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3001", "--directory", "novi-finance-site"],
      "port": 3001
    },
    {
      "name": "Novi Finance Form (Node.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}/form-ghl",
      "port": 3002
    }
  ]
}
